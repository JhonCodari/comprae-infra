# ===========================================
# VARIÁVEIS DE AMBIENTE DA INFRAESTRUTURA COMPRAÊ
# ===========================================

# Configuração do Banco de Dados
POSTGRES_DB=comprae
POSTGRES_USER=comprae_user
POSTGRES_PASSWORD=comprae_pass

# Configuração do Redis
REDIS_PASSWORD=

# Configuração do Apache Kafka
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Configuração do Elasticsearch
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Configuração do Grafana
GF_SECURITY_ADMIN_PASSWORD=admin123

# Configuração do Spring Boot
SPRING_PROFILES_ACTIVE=docker

# Configuração do Eureka
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka-server:8761/eureka

# Configuração do Config Server
SPRING_CLOUD_CONFIG_SERVER_GIT_URI=https://github.com/JonatasSilvaDev/comprae-config-repo

# Configuração do Zipkin
SPRING_ZIPKIN_BASE_URL=http://zipkin:9411

# ===========================================
# SOBRESCRIÇÕES DO AMBIENTE DE DESENVOLVIMENTO
# ===========================================

# Configuração do Banco de Dados para Desenvolvimento
DEV_POSTGRES_DB=comprae_dev
DEV_POSTGRES_USER=dev_user
DEV_POSTGRES_PASSWORD=dev_pass

# Configuração do Kafka para Desenvolvimento
DEV_KAFKA_BOOTSTRAP_SERVERS=kafka-dev:29092

# Configuração do Elasticsearch para Desenvolvimento
DEV_ES_JAVA_OPTS=-Xms256m -Xmx256m
